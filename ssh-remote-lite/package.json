{
  "name": "ssh-remote-lite",
  "displayName": "SSH Remote Lite",
  "description": "轻量级 SSH 远程开发:不依赖远端 vscode-server,用 ssh:// 文件系统浏览/编辑远端文件 + 交互式 SSH 终端。适用于跑不了新版 vscode-server 的老服务器(CentOS 7 / glibc < 2.28 等)。",
  "version": "0.0.7",
  "publisher": "shaohuawen03",
  "license": "MIT",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onFileSystem:ssh",
    "onTerminalProfile:sshRemoteLite.terminal",
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "sshRemoteLite.quickSetup",
        "title": "SSH Remote Lite: 一键配置远程主机 (存密码 + 免密 + 设为默认终端)"
      },
      {
        "command": "sshRemoteLite.connect",
        "title": "SSH Remote Lite: 连接到主机..."
      },
      {
        "command": "sshRemoteLite.openTerminal",
        "title": "SSH Remote Lite: 新建 SSH 终端"
      },
      {
        "command": "sshRemoteLite.setDefaultTerminal",
        "title": "SSH Remote Lite: 把 SSH 设为默认终端 (Agent 命令跑在远端)"
      },
      {
        "command": "sshRemoteLite.uploadPublicKey",
        "title": "SSH Remote Lite: 部署免密登录 (上传本机公钥)"
      }
    ],
    "configuration": {
      "title": "SSH Remote Lite",
      "properties": {
        "sshRemoteLite.hosts": {
          "type": "array",
          "default": [],
          "description": "预配置主机列表。例: [{ \"name\": \"old-box\", \"host\": \"10.0.0.5\", \"port\": 22, \"username\": \"root\", \"password\": \"xxx\", \"privateKeyPath\": \"~/.ssh/id_rsa\" }]",
          "items": {
            "type": "object"
          }
        },
        "sshRemoteLite.autoOpenTerminal": {
          "type": "boolean",
          "default": true,
          "description": "打开 ssh:// 远程工作区时自动开一个 SSH 终端。想让终端面板 + 号新建的也是远端, 请运行命令 \"SSH Remote Lite: 把 SSH 设为默认终端\""
        },
        "sshRemoteLite.sshPath": {
          "type": "string",
          "default": "",
          "description": "自定义 ssh 可执行文件路径(默认自动查找系统 ssh / Windows OpenSSH)"
        },
        "sshRemoteLite.defaultHost": {
          "type": "string",
          "default": "",
          "description": "默认远程主机 user@host[:port](没有打开 ssh:// 工作区时, 终端 profile 用它)。例: 25wenshaohua@10.10.5.210:22"
        }
      }
    },
    "terminal": {
      "profiles": [
        {
          "id": "sshRemoteLite.terminal",
          "title": "SSH Remote Lite",
          "icon": "remote"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -w -p .",
    "test": "npm run compile && node --test \"out/test/*.test.js\"",
    "it": "node it/runTest.js"
  },
  "dependencies": {
    "ssh2": "^1.16.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/ssh2": "^1.15.6",
    "@types/vscode": "~1.75.0",
    "typescript": "^5.4.0",
    "@vscode/test-electron": "^2.4.1",
    "mocha": "^10.4.0"
  }
}
